<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Indicador de Matéria -->
    <TextView
        android:id="@+id/txtQuizMateria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matéria: LLP"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <!-- Texto da Pergunta -->
    <TextView
        android:id="@+id/txtEnunciado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enunciado da pergunta carregado aqui..."
        android:textSize="20sp"
        android:layout_marginBottom="32dp" />

    <!-- 4 Botões de Resposta -->
    <Button
        android:id="@+id/btnOpcao0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Opção A" />

    <Button
        android:id="@+id/btnOpcao1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Opção B" />

    <Button
        android:id="@+id/btnOpcao2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Opção C" />

    <Button
        android:id="@+id/btnOpcao3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opção D" />

</LinearLayout>